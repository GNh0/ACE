    {
      "id": "no-cte",
      "rule": "no CTE",
      "type": "sql_check",
      "file": "sp_TEST200_SELECT.sql",
      "item": "CTE"
    },
    {
      "id": "master-left",
      "rule": "MS020T/MS030T are LEFT OUTER JOIN",
      "type": "sql_check",
      "file": "sp_TEST200_SELECT.sql",
      "item": "마스터 테이블"
    },
    {
      "id": "no-having",
      "rule": "no HAVING filter",
      "type": "regex_absent",
      "file": "sp_TEST200_SELECT.sql",
      "pattern": "\\bHAVING\\b"
    },
    {
      "id": "on-keys-only",
      "rule": "ON holds join keys only (USEYN filter moves to WHERE)",
      "type": "regex_absent",
      "file": "sp_TEST200_SELECT.sql",
      "pattern": "\\bON\\b(?:(?!\\bWHERE\\b|\\bJOIN\\b)[\\s\\S])*?\\bUSEYN\\b"
    },
    {
      "id": "empty-check",
      "rule": "empty check is ISNULL(X, '') <> '' (no NULLIF/IS NOT NULL)",
      "type": "sql_check",
      "file": "sp_TEST200_SELECT.sql",
      "item": "IS NULL / IS NOT NULL"
    },
    {
      "id": "no-fallback",
      "rule": "no ISNULL fallback to another column",
      "type": "sql_check",
      "file": "sp_TEST200_SELECT.sql",
      "item": "다른 열 대체"
    },
    {
      "id": "convert",
      "rule": "CONVERT instead of FORMAT for a plain number",
      "type": "regex_absent",
      "file": "sp_TEST200_SELECT.sql",
      "pattern": "\\bFORMAT\\s*\\(\\s*A\\.QTY"
    },
    {
