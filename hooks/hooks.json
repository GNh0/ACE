{
  "description": "ACE: blocks once before stopping when an sql-skill SP has no execution evidence or reason, or when a written file fails check_sql.py / check_designer.py. ACE_HOOK=off turns it off.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-B", "${CLAUDE_PLUGIN_ROOT}/hooks/ace_stop_check.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-B", "${CLAUDE_PLUGIN_ROOT}/hooks/ace_stop_check.py"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
